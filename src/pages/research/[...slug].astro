---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map(paper => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await paper.render();

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long'
}).format(paper.data.date);
---

<BaseLayout title={paper.data.title} description={paper.data.description}>
  <article>
    <header class="paper-header">
      <h1>{paper.data.title}</h1>
      <p class="authors">{paper.data.authors.join(', ')}</p>
      <div class="meta">
        {paper.data.journal && (
          <span class="journal">{paper.data.journal}</span>
        )}
        <time datetime={paper.data.date.toISOString()}>{formattedDate}</time>
      </div>
      <div class="links">
        {paper.data.arxiv && (
          <a href={paper.data.arxiv} target="_blank" rel="noopener noreferrer">
            arXiv &rarr;
          </a>
        )}
        {paper.data.doi && (
          <a href={`https://doi.org/${paper.data.doi}`} target="_blank" rel="noopener noreferrer">
            DOI &rarr;
          </a>
        )}
        {paper.data.pdf && (
          <a href={paper.data.pdf} target="_blank" rel="noopener noreferrer">
            PDF &rarr;
          </a>
        )}
      </div>
    </header>

    <div class="content">
      <Content />
    </div>
  </article>

  <nav class="navigation">
    <a href="/research">&larr; Back to all research</a>
  </nav>
</BaseLayout>

<style>
  .paper-header {
    margin-bottom: var(--space-xl);
  }

  .paper-header h1 {
    margin-bottom: var(--space-sm);
  }

  .authors {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .journal {
    font-style: italic;
  }

  .links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .links a {
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .content {
    margin-bottom: var(--space-xl);
  }

  .navigation {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .navigation a {
    font-family: var(--font-sans);
  }
</style>
