---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const diagramMap: Record<string, string> = {
  'sam-audio': '/diagrams/sam-audio.svg',
  'sam-audio-judge': '/diagrams/sam-audio-judge.svg',
  'movie-gen': '/diagrams/movie-gen.svg',
  'seamless-m4t': '/diagrams/seamless-m4t.svg',
  'nllb': '/diagrams/nllb.svg',
  'fast-template-periodogram': '/diagrams/fast-template-periodogram.svg',
};

const allResearch = (await getCollection('research'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Research" description="Publications and research in astrophysics and machine learning.">
  <h1>Research & Publications</h1>

  {allResearch.length === 0 ? (
    <p>No publications listed yet. Check back soon!</p>
  ) : (
    <ul class="research-list">
      {allResearch.map(paper => (
        <li>
          <a href={paper.data.arxiv || (paper.data.doi ? `https://doi.org/${paper.data.doi}` : '#')} target="_blank" rel="noopener noreferrer" class="paper-card">
            {diagramMap[paper.slug] && (
              <div class="card-diagram">
                <img src={diagramMap[paper.slug]} alt="" />
              </div>
            )}
            <h2>{paper.data.title}</h2>
            <p class="authors">{paper.data.authors.join(', ')}</p>
            <p class="description">{paper.data.description}</p>
            <div class="meta">
              {paper.data.journal && (
                <span class="journal">{paper.data.journal}</span>
              )}
              <time datetime={paper.data.date.toISOString()}>
                {new Intl.DateTimeFormat('en-US', {
                  year: 'numeric',
                  month: 'long'
                }).format(paper.data.date)}
              </time>
            </div>
            <div class="links">
              {paper.data.arxiv && (
                <span class="link-tag">arXiv</span>
              )}
              {paper.data.doi && (
                <span class="link-tag">DOI</span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-lg);
  }

  .research-list {
    list-style: none;
    margin-left: 0;
  }

  .research-list li {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .research-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .paper-card {
    text-decoration: none;
    display: block;
  }

  .card-diagram {
    margin-bottom: var(--space-sm);
  }

  .card-diagram img {
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 12px 16px;
    background: var(--color-background);
  }

  .paper-card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .paper-card h2 {
    margin: 0 0 var(--space-xs);
    font-size: 1.3rem;
  }

  .authors {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .journal {
    font-style: italic;
  }

  .links {
    display: flex;
    gap: var(--space-xs);
  }

  .link-tag {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    padding: 0.1em 0.5em;
    border-radius: 3px;
    color: var(--color-text-secondary);
  }

</style>
