---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const diagramMap: Record<string, string> = {
  'cuvarbase': '/diagrams/cuvarbase.svg',
  'fast-template-periodogram': '/diagrams/fast-template-periodogram.svg',
};

const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects" description="Technical projects and software development work.">
  <h1>Projects</h1>

  {allProjects.length === 0 ? (
    <p>No projects yet. Check back soon!</p>
  ) : (
    <ul class="project-list">
      {allProjects.map(project => (
        <li>
          <a href={project.data.github || project.data.link} target="_blank" rel="noopener noreferrer" class="project-card">
            {diagramMap[project.slug] && (
              <div class="card-diagram">
                <img src={diagramMap[project.slug]} alt="" />
              </div>
            )}
            <h2>{project.data.title}</h2>
            <p class="description">{project.data.description}</p>
            <div class="meta">
              <time datetime={project.data.date.toISOString()}>
                {new Intl.DateTimeFormat('en-US', {
                  year: 'numeric',
                  month: 'long'
                }).format(project.data.date)}
              </time>
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="tags">
                  {project.data.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-lg);
  }

  .project-list {
    list-style: none;
    margin-left: 0;
  }

  .project-list li {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .project-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-card {
    text-decoration: none;
    display: block;
  }

  .card-diagram {
    margin-bottom: var(--space-sm);
  }

  .card-diagram img {
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 12px 16px;
    background: var(--color-background);
  }

  .project-card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-list h2 {
    margin: 0 0 var(--space-xs);
    transition: color 0.2s ease;
  }

  .description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: var(--space-xs);
  }

  .tag {
    border: 1px solid var(--color-border);
    padding: 0.15em 0.5em;
    border-radius: 3px;
    font-size: 0.85rem;
  }

</style>
