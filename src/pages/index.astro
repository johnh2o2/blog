---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const featuredProjects = (await getCollection('projects'))
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const allResearch = (await getCollection('research'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 7);
---

<BaseLayout title="John Hoffman — Data Scientist & Researcher">
  <section class="hero">
    <img src="/profile.jpg" alt="John Hoffman" class="profile-photo" />
    <h1>John Hoffman</h1>
    <p class="subtitle">Staff Data Scientist, FAIR (Meta)</p>
  </section>

  <section class="about">
    <p>
      I'm a staff data scientist at Meta's Fundamental AI Research lab, where I drive evaluation and data strategy for
      large-scale AI systems. I co-led evaluation for
      <a href="https://arxiv.org/abs/2410.13720" target="_blank" rel="noopener noreferrer">Movie Gen</a> and was a core contributor to
      <a href="https://arxiv.org/abs/2512.07768" target="_blank" rel="noopener noreferrer">SAM Audio</a>, leading all human evaluations.
      Two of the projects I've worked on — <a href="https://arxiv.org/abs/2308.11596" target="_blank" rel="noopener noreferrer">SeamlessM4T</a>
      and <a href="https://arxiv.org/abs/2207.04672" target="_blank" rel="noopener noreferrer">NLLB</a> — were published in Nature.
    </p>
    <p>
      Before FAIR, I earned a PhD in astrophysics from Princeton, where I developed
      GPU-accelerated methods for astronomical time-series analysis. My thesis library,
      <a href="https://github.com/johnh2o2/cuvarbase" target="_blank" rel="noopener noreferrer">cuvarbase</a>, was adopted by
      <a href="https://arxiv.org/abs/2302.01293" target="_blank" rel="noopener noreferrer">NASA's TESS pipeline</a>
      and enabled a <a href="https://doi.org/10.1038/s41586-019-1403-0" target="_blank" rel="noopener noreferrer">Nature-published discovery</a> of ultracompact binary stars.
      I also worked in ML consulting and ad-tech before joining Meta.
    </p>
    <div class="links">
      <a href="/JohnHoffmanResume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
      <a href="https://github.com/johnh2o2" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://scholar.google.com/citations?user=XhFj1WIAAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>
      <a href="https://www.linkedin.com/in/johnh2o2/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>

  {allResearch.length > 0 && (
    <section class="section">
      <h2>Selected Publications</h2>
      <ul class="pub-list">
        {allResearch.map(paper => (
          <li>
            <a href={paper.data.arxiv || (paper.data.doi ? `https://doi.org/${paper.data.doi}` : '#')} target="_blank" rel="noopener noreferrer">{paper.data.title}</a>
            <span class="meta">
              {paper.data.journal && <em>{paper.data.journal}</em>}
              {paper.data.journal && ", "}
              {new Intl.DateTimeFormat('en-US', { year: 'numeric' }).format(paper.data.date)}
            </span>
          </li>
        ))}
      </ul>
      <a href="/research" class="view-all">All publications &rarr;</a>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="section">
      <h2>Featured Projects</h2>
      <ul class="proj-list">
        {featuredProjects.map(project => (
          <li>
            <a href={project.data.github || project.data.link} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
            <span class="meta">{project.data.description}</span>
          </li>
        ))}
      </ul>
      <a href="/projects" class="view-all">All projects &rarr;</a>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .profile-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto var(--space-md);
  }

  .hero h1 {
    margin: 0 0 var(--space-xs);
    font-size: 2.2rem;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .about {
    margin-bottom: var(--space-xl);
  }

  .about p {
    font-size: 1.05rem;
  }

  .links {
    display: flex;
    gap: var(--space-lg);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .section {
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .pub-list, .proj-list {
    list-style: none;
    margin-left: 0;
  }

  .pub-list li, .proj-list li {
    margin-bottom: var(--space-sm);
  }

  .pub-list li a, .proj-list li a {
    font-weight: 600;
  }

  .meta {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .view-all {
    display: inline-block;
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
</style>
