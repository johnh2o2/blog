---
const viewer = 'https://cosmic-web-film.cosmology-lab-ac48dc.workers.dev/';
---

<div class="film-watch">
  <a href={viewer} class="watch">Watch in 360° <span aria-hidden="true">↗</span></a>
  <p>9 minutes 45 seconds · Sound on · Optional narration</p>
</div>

<style>
  .film-watch { margin: var(--space-lg) 0; }
  .watch {
    display: inline-block;
    padding: .65rem 1rem;
    border: 1px solid var(--color-text);
    font: 600 1rem/1.5 var(--font-sans);
    text-decoration: none;
  }
  .watch:hover { background: var(--color-code-bg); }
  .watch:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; }
  .film-watch p {
    margin: var(--space-xs) 0 0;
    font: .85rem/1.6 var(--font-sans);
    color: var(--color-text-secondary);
  }
</style>
