---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  number?: number;
  width?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const { src, alt, caption, number, width = '100%', imageWidth, imageHeight } = Astro.props;
---

<figure>
  <img src={src} alt={alt} width={imageWidth} height={imageHeight} style={`max-width: ${width}; height: auto;`} />
  {caption && (
    <figcaption>
      {number && <strong>Figure {number}.</strong>} {caption}
    </figcaption>
  )}
</figure>
